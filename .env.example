# Separate Passage Authority environment only. Never use the legacy Passage project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTHORITY_APP_URL=http://127.0.0.1:3000

# Local Gate 1 verification writes secure team links to an ignored local mailbox.
# Use `resend` for hosted UAT and production delivery.
AUTHORITY_TEAM_INVITATION_DELIVERY=
AUTHORITY_PARTICIPANT_INVITATION_DELIVERY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
AUTHORITY_EMAIL_FROM=Passage Authority <noreply@thepassageapp.io>

# Server-only commercial integrations. Use Stripe test mode in Demo and a
# separate HubSpot developer test account. Never expose these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PILOT_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_WEBHOOK_CLIENT_SECRET=

# Required together for Demo-only delivery and fresh-run provisioning.
# Use comma-separated exact email addresses. Wildcards and domains are rejected.
PASSAGE_ENVIRONMENT=local
PASSAGE_EMAIL_RECIPIENT_ALLOWLIST=
PASSAGE_DEMO_PRESENTER_ALLOWLIST=

# Local SQLite regression harness only. Production builds deny its UI, API, and actions.
AUTHORITY_SANDBOX_API_KEY=
AUTHORITY_SANDBOX_COOKIE_SECRET=
AUTHORITY_SANDBOX_WEBHOOK_SECRET=
