{
  "name": "passage-authority",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types --test src/lib/authority/*.test.mts",
    "verify:gate1:database": "node scripts/verify-gate1-database.mjs",
    "verify:live-story": "node scripts/verify-live-story.mjs",
    "verify:public-release": "node scripts/verify-public-release.mjs",
    "verify": "pnpm test:domain && pnpm typecheck && pnpm lint && pnpm build"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "6.9.3",
    "resend": "6.24.0",
    "stripe": "22.6.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.6",
    "typescript": "5.9.3"
  }
}
